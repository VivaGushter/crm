INDEX_HTML = '<!DOCTYPE html>\n<html lang="ru">\n<head>\n  <meta charset="UTF-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">\n  <title>CRM заявок мастера</title>\n  <link rel="preconnect" href="https://api.fontshare.com">\n  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">\n  <style>\n    :root, [data-theme="light"] { --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem); --text-sm: clamp(0.95rem, 0.9rem + 0.25vw, 1rem); --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem); --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.4rem); --text-xl: clamp(1.55rem, 1.2rem + 1vw, 2rem); --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem; --space-5: 1.25rem; --space-6: 1.5rem; --space-8: 2rem; --space-10: 2.5rem; --space-12: 3rem; --color-bg: #f7f6f2; --color-surface: #f9f8f5; --color-surface-2: #fbfbf9; --color-surface-offset: #f3f0ec; --color-border: #d4d1ca; --color-divider: #dcd9d5; --color-text: #28251d; --color-text-muted: #706d67; --color-text-inverse: #f9f8f4; --color-primary: #01696f; --color-primary-hover: #0c4e54; --color-primary-highlight: #d7e3df; --color-success: #437a22; --color-warning: #da7101; --color-error: #a13544; --color-blue: #006494; --color-purple: #7a39bb; --radius-sm: 0.375rem; --radius-md: 0.65rem; --radius-lg: 0.9rem; --radius-xl: 1.1rem; --radius-full: 9999px; --shadow-sm: 0 1px 2px rgba(40, 37, 29, 0.06); --shadow-md: 0 8px 24px rgba(40, 37, 29, 0.09); --font-display: \'Satoshi\', \'Inter\', sans-serif; --font-body: \'General Sans\', \'Inter\', sans-serif; --safe-bottom: env(safe-area-inset-bottom, 0px); }\n    [data-theme="dark"] { --color-bg: #171614; --color-surface: #1c1b19; --color-surface-2: #201f1d; --color-surface-offset: #262321; --color-border: #393836; --color-divider: #2b2a28; --color-text: #eceae5; --color-text-muted: #b2aea8; --color-text-inverse: #141311; --color-primary: #4f98a3; --color-primary-hover: #227f8b; --color-primary-highlight: #2b3938; --color-success: #6daa45; --color-warning: #edb336; --color-error: #dd6974; --color-blue: #5591c7; --color-purple: #a86fdf; --shadow-sm: 0 1px 3px rgba(0,0,0,0.22); --shadow-md: 0 10px 28px rgba(0,0,0,0.35); }\n    * { box-sizing: border-box; } html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; } body { margin: 0; background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); font-size: var(--text-base); line-height: 1.55; }\n    button, input, textarea, select { font: inherit; color: inherit; } button { cursor: pointer; } a { color: inherit; text-decoration: none; }\n    input, textarea, select { width: 100%; min-height: 48px; padding: 0.85rem 0.95rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface-2); font-size: 16px; }\n    textarea { min-height: 104px; resize: vertical; } .app-shell { max-width: 1280px; margin: 0 auto; padding: var(--space-4); padding-bottom: calc(var(--space-12) + var(--safe-bottom)); }\n    .topbar { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-5); } .brand-wrap { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }\n    .brand-title { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.05; } .subtitle { color: var(--color-text-muted); margin-top: 0.4rem; }\n    .header-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: flex-end; } .layout { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }\n    .card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); overflow: hidden; } .panel { padding: var(--space-4); } .panel + .panel { border-top: 1px solid var(--color-divider); }\n    .title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-3); } .title-row h2, .title-row h3 { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.15; }\n    .muted { color: var(--color-text-muted); } .btn { min-height: 48px; padding: 0.85rem 1rem; border: 1px solid transparent; border-radius: var(--radius-md); background: transparent; display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; font-weight: 700; transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease; -webkit-tap-highlight-color: transparent; }\n    .btn:active { transform: scale(0.98); } .btn-primary { background: var(--color-primary); color: var(--color-text-inverse); } .btn-primary:hover { background: var(--color-primary-hover); } .btn-secondary { background: var(--color-surface); border-color: var(--color-border); } .btn-danger { background: transparent; border-color: rgba(161,53,68,0.3); color: var(--color-error); } .btn-icon { width: 48px; min-width: 48px; padding: 0; }\n    .pill { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 40px; padding: 0 0.85rem; border-radius: var(--radius-full); border: 1px solid var(--color-border); background: var(--color-surface-2); font-size: var(--text-sm); } .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }\n    .stat { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); } .stat-k { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: 0.35rem; } .stat-v { font-family: var(--font-display); font-size: 1.8rem; line-height: 1.05; }\n    .calendar-toolbar { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-2); align-items: center; margin-bottom: var(--space-4); } .month-label { text-align: center; font-family: var(--font-display); font-size: var(--text-lg); }\n    .weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-2); } .weekday { text-align: center; color: var(--color-text-muted); font-size: var(--text-xs); font-weight: 700; padding-bottom: var(--space-2); }\n    .day-cell { min-height: 88px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-surface-2); padding: 0.55rem; display: flex; flex-direction: column; align-items: stretch; gap: 0.4rem; text-align: left; } .day-cell.other-month { opacity: 0.55; } .day-cell.has-events { background: var(--color-primary-highlight); } .day-cell.active-day { outline: 2px solid var(--color-primary); outline-offset: 0; }\n    .day-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); font-size: var(--text-sm); font-weight: 700; } .count-badge { min-width: 22px; height: 22px; border-radius: var(--radius-full); display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; background: var(--color-primary); color: var(--color-text-inverse); padding: 0 0.4rem; }\n    .mini-events { display: grid; gap: 0.25rem; overflow: hidden; } .mini-event { font-size: 0.75rem; line-height: 1.25; border-radius: 999px; padding: 0.18rem 0.45rem; background: rgba(1,105,111,0.12); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } [data-theme="dark"] .mini-event { background: rgba(79,152,163,0.16); }\n    .mini-event.s-new { color: var(--color-blue); } .mini-event.s-scheduled { color: var(--color-purple); } .mini-event.s-work { color: var(--color-warning); } .mini-event.s-done { color: var(--color-success); } .mini-event.s-cancel { color: var(--color-error); }\n    .filters { display: grid; gap: var(--space-3); } .requests-list { display: grid; gap: var(--space-3); } .request-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-2); padding: var(--space-4); display: grid; gap: var(--space-3); }\n    .request-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); } .request-name { font-weight: 800; font-size: 1.05rem; }\n    .badge { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 0 0.75rem; border-radius: var(--radius-full); font-size: 0.78rem; font-weight: 800; }\n    .new { background: rgba(0,100,148,0.12); color: var(--color-blue); } .scheduled { background: rgba(122,57,187,0.13); color: var(--color-purple); } .work { background: rgba(218,113,1,0.13); color: var(--color-warning); } .done { background: rgba(67,122,34,0.13); color: var(--color-success); } .cancel { background: rgba(161,53,68,0.13); color: var(--color-error); }\n    .request-meta { display: grid; gap: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); } .actions-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }\n    .fab-wrap { position: sticky; bottom: calc(var(--space-4) + var(--safe-bottom)); display: flex; justify-content: center; padding-top: var(--space-4); pointer-events: none; } .fab { pointer-events: auto; min-width: min(92vw, 420px); box-shadow: var(--shadow-md); }\n    .login-wrap { min-height: 100dvh; display: grid; place-items: center; padding: var(--space-4); } .login-card { width: min(100%, 420px); } .field { display: grid; gap: var(--space-2); margin-bottom: var(--space-4); } .field label { font-size: var(--text-sm); font-weight: 700; }\n    .note { padding: var(--space-4); border-radius: var(--radius-lg); background: var(--color-primary-highlight); color: var(--color-text); font-size: var(--text-sm); } .drawer { position: fixed; inset: 0; background: rgba(0,0,0,0.32); display: none; align-items: flex-end; justify-content: center; z-index: 30; padding: 0; } .drawer.open { display: flex; }\n    .drawer-panel { width: min(100%, 720px); max-height: 94dvh; overflow: auto; background: var(--color-bg); border-radius: 1.2rem 1.2rem 0 0; box-shadow: var(--shadow-md); padding: var(--space-4); padding-bottom: calc(var(--space-8) + var(--safe-bottom)); } .drawer-handle { width: 56px; height: 6px; border-radius: 999px; background: var(--color-border); margin: 0 auto var(--space-4); }\n    .empty-state { padding: var(--space-5); border-radius: var(--radius-lg); background: var(--color-surface-2); border: 1px dashed var(--color-border); color: var(--color-text-muted); } .desktop-only { display: none; }\n    @media (min-width: 980px) { .app-shell { padding: var(--space-5); } .topbar { margin-bottom: var(--space-6); } .layout { grid-template-columns: minmax(0, 1.1fr) minmax(320px, 400px); align-items: start; } .desktop-only { display: block; } .stats { grid-template-columns: repeat(5, 1fr); } .filters { grid-template-columns: repeat(4, 1fr); } .fab-wrap { display: none; } }\n  </style>\n</head>\n<body>\n  <section id="loginView" class="login-wrap"><div class="card login-card"><div class="panel"><h1 class="brand-title">CRM заявок мастера</h1><p class="subtitle">Мобильная версия с календарём, датой выезда и общей базой для двух мастеров.</p></div><div class="panel"><div class="field"><label for="loginUser">Логин</label><input id="loginUser" value="master1" autocomplete="username"></div><div class="field"><label for="loginPass">Пароль</label><input id="loginPass" type="password" value="1111" autocomplete="current-password"></div><button id="loginBtn" type="button" class="btn btn-primary" style="width:100%">Войти</button><div class="note" style="margin-top:1rem;">Демо-доступ: master1 / 1111 и master2 / 2222. После запуска на VPS пароли лучше сразу сменить.</div></div></div></section>\n  <main id="appView" style="display:none;"><div class="app-shell"><header class="topbar"><div class="brand-wrap"><div><h1 class="brand-title">CRM заявок</h1><div class="subtitle">Календарь, выезды, статусы и быстрый доступ со смартфона.</div></div><div class="header-actions"><span class="pill" id="sessionPill">Не авторизован</span><button class="btn btn-secondary btn-icon" id="themeBtn" type="button" aria-label="Тема">🌙</button><button class="btn btn-secondary" id="logoutBtn" type="button">Выйти</button></div></div><section class="stats" aria-label="Статистика"><div class="stat"><div class="stat-k">Всего</div><div class="stat-v" id="statTotal">0</div></div><div class="stat"><div class="stat-k">Сегодня</div><div class="stat-v" id="statToday">0</div></div><div class="stat"><div class="stat-k">Назначено</div><div class="stat-v" id="statScheduled">0</div></div><div class="stat"><div class="stat-k">Завершено</div><div class="stat-v" id="statDone">0</div></div><div class="stat"><div class="stat-k">Сумма завершённых</div><div class="stat-v" id="statRevenue">0 ₽</div></div></section></header><div class="layout"><section class="card"><div class="panel"><div class="title-row"><div><h2>Календарь выездов</h2><div class="muted">Наглядно видно занятые дни и записи на выбранную дату.</div></div></div><div class="calendar-toolbar"><button class="btn btn-secondary btn-icon" id="prevMonthBtn" type="button" aria-label="Предыдущий месяц">←</button><div class="month-label" id="monthLabel">Месяц</div><button class="btn btn-secondary btn-icon" id="nextMonthBtn" type="button" aria-label="Следующий месяц">→</button></div><div class="weekdays" aria-hidden="true"><div class="weekday">Пн</div><div class="weekday">Вт</div><div class="weekday">Ср</div><div class="weekday">Чт</div><div class="weekday">Пт</div><div class="weekday">Сб</div><div class="weekday">Вс</div></div><div id="calendarGrid" class="calendar-grid"></div></div><div class="panel"><div class="title-row"><div><h3 id="selectedDateTitle">Заявки на день</h3><div class="muted">Коснись дня в календаре, чтобы увидеть записи.</div></div><button class="btn btn-primary desktop-only" id="openFormDesktopBtn" type="button">+ Новая заявка</button></div><div class="filters" style="margin-bottom:1rem;"><input id="searchInput" placeholder="Поиск по клиенту, адресу, телефону"><select id="statusFilter"><option value="all">Все статусы</option><option value="new">Новые</option><option value="scheduled">Назначенные</option><option value="work">В работе</option><option value="done">Завершённые</option><option value="cancel">Отменённые</option></select><select id="assigneeFilter"><option value="all">Все мастера</option><option value="master1">Мастер 1</option><option value="master2">Мастер 2</option></select><input id="directDateFilter" type="date"></div><div id="requestsList" class="requests-list"></div></div></section><aside class="card desktop-only"><div class="panel"><div class="title-row"><div><h2>Быстрое создание</h2><div class="muted">На телефоне форма открывается на весь экран.</div></div></div><div class="note">В карточке заявки есть дата и время выезда, ответственный мастер, сумма и комментарий. Всё под ручной ввод и работу вдвоём.</div></div><div class="panel"><button class="btn btn-primary" style="width:100%" id="openFormAsideBtn" type="button">Открыть форму заявки</button></div></aside></div><div class="fab-wrap"><button class="btn btn-primary fab" id="openFormFabBtn" type="button">+ Новая заявка</button></div></div></main>\n  <div id="drawer" class="drawer"><div class="drawer-panel"><div class="drawer-handle"></div><div class="title-row"><div><h2 id="drawerTitle">Новая заявка</h2><div class="muted">Форма оптимизирована для смартфона.</div></div><button class="btn btn-secondary" id="closeDrawerBtn" type="button">Закрыть</button></div><form id="requestForm"><input type="hidden" id="requestId"><div class="field"><label for="clientInput">Клиент</label><input id="clientInput" required></div><div class="field"><label for="visitDateInput">Дата и время выезда</label><input id="visitDateInput" type="datetime-local" required></div><div class="field"><label for="addressInput">Адрес</label><input id="addressInput" required></div><div class="field"><label for="phoneInput">Телефон</label><input id="phoneInput" required inputmode="tel"></div><div class="field"><label for="statusInput">Статус</label><select id="statusInput"><option value="new">Новая</option><option value="scheduled">Назначена</option><option value="work">В работе</option><option value="done">Завершена</option><option value="cancel">Отменена</option></select></div><div class="field"><label for="priceInput">Цена</label><input id="priceInput" type="number" min="0" step="1" inputmode="numeric"></div><div class="field"><label for="assigneeInput">Ответственный</label><select id="assigneeInput"><option value="master1">Мастер 1</option><option value="master2">Мастер 2</option></select></div><div class="field"><label for="commentInput">Комментарий</label><textarea id="commentInput"></textarea></div><div class="actions-row" style="margin-top:1rem;"><button class="btn btn-secondary" id="resetFormBtn" type="button">Очистить</button><button class="btn btn-primary" id="saveBtn" type="submit">Сохранить</button></div></form></div></div>\n  <script>\n    const state={auth:null,items:[],currentMonth:(()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1)})(),selectedDate:new Date().toISOString().slice(0,10),theme:window.matchMedia(\'(prefers-color-scheme: dark)\').matches?\'dark\':\'light\'};\n    const statusLabels={new:\'Новая\',scheduled:\'Назначена\',work:\'В работе\',done:\'Завершена\',cancel:\'Отменена\'};\n    const els={loginView:document.getElementById(\'loginView\'),appView:document.getElementById(\'appView\'),loginUser:document.getElementById(\'loginUser\'),loginPass:document.getElementById(\'loginPass\'),loginBtn:document.getElementById(\'loginBtn\'),logoutBtn:document.getElementById(\'logoutBtn\'),themeBtn:document.getElementById(\'themeBtn\'),sessionPill:document.getElementById(\'sessionPill\'),statTotal:document.getElementById(\'statTotal\'),statToday:document.getElementById(\'statToday\'),statScheduled:document.getElementById(\'statScheduled\'),statDone:document.getElementById(\'statDone\'),statRevenue:document.getElementById(\'statRevenue\'),monthLabel:document.getElementById(\'monthLabel\'),prevMonthBtn:document.getElementById(\'prevMonthBtn\'),nextMonthBtn:document.getElementById(\'nextMonthBtn\'),calendarGrid:document.getElementById(\'calendarGrid\'),selectedDateTitle:document.getElementById(\'selectedDateTitle\'),requestsList:document.getElementById(\'requestsList\'),searchInput:document.getElementById(\'searchInput\'),statusFilter:document.getElementById(\'statusFilter\'),assigneeFilter:document.getElementById(\'assigneeFilter\'),directDateFilter:document.getElementById(\'directDateFilter\'),openFormFabBtn:document.getElementById(\'openFormFabBtn\'),openFormDesktopBtn:document.getElementById(\'openFormDesktopBtn\'),openFormAsideBtn:document.getElementById(\'openFormAsideBtn\'),drawer:document.getElementById(\'drawer\'),drawerTitle:document.getElementById(\'drawerTitle\'),closeDrawerBtn:document.getElementById(\'closeDrawerBtn\'),requestForm:document.getElementById(\'requestForm\'),requestId:document.getElementById(\'requestId\'),clientInput:document.getElementById(\'clientInput\'),visitDateInput:document.getElementById(\'visitDateInput\'),addressInput:document.getElementById(\'addressInput\'),phoneInput:document.getElementById(\'phoneInput\'),statusInput:document.getElementById(\'statusInput\'),priceInput:document.getElementById(\'priceInput\'),assigneeInput:document.getElementById(\'assigneeInput\'),commentInput:document.getElementById(\'commentInput\'),resetFormBtn:document.getElementById(\'resetFormBtn\')};\n    function setTheme(theme){state.theme=theme;document.documentElement.setAttribute(\'data-theme\',theme);els.themeBtn.textContent=theme===\'dark\'?\'☀️\':\'🌙\';}\n    function authHeaders(){if(!state.auth)return{};return{Authorization:\'Basic \'+btoa(state.auth.user+\':\'+state.auth.pass)}}\n    async function api(path,options={}){const res=await fetch(path,{...options,headers:{\'Content-Type\':\'application/json\',...authHeaders(),...(options.headers||{})}});if(res.status===401){logout(false);throw new Error(\'auth\')}if(!res.ok){const text=await res.text();throw new Error(text||\'Ошибка запроса\')}const type=res.headers.get(\'content-type\')||\'\';return type.includes(\'application/json\')?res.json():res.text()}\n    function formatMoney(value){return new Intl.NumberFormat(\'ru-RU\').format(Number(value||0))+\' ₽\'}\n    function formatDateTime(value){const d=new Date(value);return new Intl.DateTimeFormat(\'ru-RU\',{dateStyle:\'short\',timeStyle:\'short\'}).format(d)}\n    function formatDateLabel(dateStr){const d=new Date(dateStr+\'T00:00:00\');return new Intl.DateTimeFormat(\'ru-RU\',{weekday:\'long\',day:\'numeric\',month:\'long\'}).format(d)}\n    function escapeHtml(v){return String(v??\'\').replace(/[&<>"\']/g,s=>({\'&\':\'&amp;\',\'<\':\'&lt;\',\'>\':\'&gt;\',\'"\':\'&quot;\',"\'":\'&#39;\'}[s]))}\n    function dateKeyFromValue(value){return String(value).slice(0,10)}\n    function resetForm(){els.requestForm.reset();els.requestId.value=\'\';els.statusInput.value=\'new\';els.assigneeInput.value=state.auth?state.auth.user:\'master1\';const base=state.selectedDate?new Date(state.selectedDate+\'T10:00:00\'):new Date();base.setMinutes(0,0,0);els.visitDateInput.value=base.toISOString().slice(0,16);els.drawerTitle.textContent=\'Новая заявка\';}\n    function openDrawer(){els.drawer.classList.add(\'open\');document.body.style.overflow=\'hidden\';}\n    function closeDrawer(){els.drawer.classList.remove(\'open\');document.body.style.overflow=\'\';}\n    function fillForm(item){els.drawerTitle.textContent=\'Редактирование заявки\';els.requestId.value=item.id;els.clientInput.value=item.client;els.visitDateInput.value=item.visit_date.slice(0,16);els.addressInput.value=item.address;els.phoneInput.value=item.phone;els.statusInput.value=item.status;els.priceInput.value=item.price||0;els.assigneeInput.value=item.assignee;els.commentInput.value=item.comment||\'\';openDrawer();}\n    async function login(){state.auth={user:els.loginUser.value.trim(),pass:els.loginPass.value};const me=await api(\'/api/me\');els.sessionPill.textContent=\'Вошёл: \'+me.name;els.loginView.style.display=\'none\';els.appView.style.display=\'block\';els.assigneeInput.value=state.auth.user;await loadItems();resetForm();}\n    function logout(withAlert=true){state.auth=null;els.loginView.style.display=\'grid\';els.appView.style.display=\'none\';closeDrawer();if(withAlert)alert(\'Вы вышли из системы\')}\n    function getFilteredItems(){const search=els.searchInput.value.trim().toLowerCase();const status=els.statusFilter.value;const assignee=els.assigneeFilter.value;const dateFilter=els.directDateFilter.value||state.selectedDate;return state.items.filter(item=>{const hay=[item.client,item.address,item.phone,item.comment||\'\',item.assignee_name].join(\' \').toLowerCase();const okSearch=!search||hay.includes(search);const okStatus=status===\'all\'||item.status===status;const okAssignee=assignee===\'all\'||item.assignee===assignee;const okDate=!dateFilter||dateKeyFromValue(item.visit_date)===dateFilter;return okSearch&&okStatus&&okAssignee&&okDate}).sort((a,b)=>a.visit_date.localeCompare(b.visit_date))}\n    function renderStats(){const today=new Date().toISOString().slice(0,10);const done=state.items.filter(i=>i.status===\'done\');els.statTotal.textContent=state.items.length;els.statToday.textContent=state.items.filter(i=>dateKeyFromValue(i.visit_date)===today).length;els.statScheduled.textContent=state.items.filter(i=>i.status===\'scheduled\').length;els.statDone.textContent=done.length;els.statRevenue.textContent=formatMoney(done.reduce((acc,item)=>acc+Number(item.price||0),0))}\n    function renderCalendar(){const monthStart=new Date(state.currentMonth.getFullYear(),state.currentMonth.getMonth(),1);const startWeekday=(monthStart.getDay()+6)%7;const gridStart=new Date(monthStart);gridStart.setDate(monthStart.getDate()-startWeekday);const counts={};state.items.forEach(item=>{const key=dateKeyFromValue(item.visit_date);if(!counts[key])counts[key]=[];counts[key].push(item)});els.monthLabel.textContent=new Intl.DateTimeFormat(\'ru-RU\',{month:\'long\',year:\'numeric\'}).format(monthStart);els.calendarGrid.innerHTML=\'\';for(let i=0;i<42;i++){const cellDate=new Date(gridStart);cellDate.setDate(gridStart.getDate()+i);const key=cellDate.toISOString().slice(0,10);const items=counts[key]||[];const btn=document.createElement(\'button\');btn.type=\'button\';btn.className=\'day-cell\';if(cellDate.getMonth()!==state.currentMonth.getMonth())btn.classList.add(\'other-month\');if(items.length)btn.classList.add(\'has-events\');if(key===state.selectedDate)btn.classList.add(\'active-day\');const preview=items.slice(0,2).map(item=>`<div class="mini-event s-${item.status}">${escapeHtml(item.client)}</div>`).join(\'\');btn.innerHTML=`<div class="day-head"><span>${cellDate.getDate()}</span>${items.length?`<span class="count-badge">${items.length}</span>`:\'\'}</div><div class="mini-events">${preview}</div>`;btn.addEventListener(\'click\',()=>{state.selectedDate=key;els.directDateFilter.value=key;renderCalendar();renderRequests()});els.calendarGrid.appendChild(btn)}}\n    function renderRequests(){const dateValue=els.directDateFilter.value||state.selectedDate;els.selectedDateTitle.textContent=\'Заявки на \'+formatDateLabel(dateValue);const rows=getFilteredItems();if(!rows.length){els.requestsList.innerHTML=\'<div class="empty-state">На выбранный день заявок нет. Можно создать новую запись через кнопку внизу.</div>\';return}els.requestsList.innerHTML=rows.map(item=>`<article class="request-card"><div class="request-top"><div><div class="request-name">${escapeHtml(item.client)}</div><div class="muted">${formatDateTime(item.visit_date)}</div></div><span class="badge ${item.status}">${statusLabels[item.status]}</span></div><div class="request-meta"><div>📍 ${escapeHtml(item.address)}</div><div>📞 <a href="tel:${escapeHtml(item.phone)}">${escapeHtml(item.phone)}</a></div><div>👤 ${escapeHtml(item.assignee_name)}</div><div>💰 ${formatMoney(item.price)}</div>${item.comment?`<div>📝 ${escapeHtml(item.comment)}</div>`:\'\'}</div><div class="actions-row"><button class="btn btn-secondary" type="button" onclick="window.editRequest(${item.id})">Изменить</button><button class="btn btn-danger" type="button" onclick="window.deleteRequest(${item.id})">Удалить</button></div></article>`).join(\'\')}\n    async function loadItems(){state.items=await api(\'/api/requests\');renderStats();renderCalendar();renderRequests()}\n    async function saveRequest(event){event.preventDefault();const payload={client:els.clientInput.value.trim(),visit_date:els.visitDateInput.value,address:els.addressInput.value.trim(),phone:els.phoneInput.value.trim(),status:els.statusInput.value,price:Number(els.priceInput.value||0),comment:els.commentInput.value.trim(),assignee:els.assigneeInput.value};if(!payload.client||!payload.visit_date||!payload.address||!payload.phone){alert(\'Заполни клиента, дату выезда, адрес и телефон\');return}if(els.requestId.value){await api(\'/api/requests/\'+els.requestId.value,{method:\'PUT\',body:JSON.stringify(payload)})}else{await api(\'/api/requests\',{method:\'POST\',body:JSON.stringify(payload)})}state.selectedDate=payload.visit_date.slice(0,10);els.directDateFilter.value=state.selectedDate;closeDrawer();resetForm();await loadItems()}\n    window.editRequest=function(id){const item=state.items.find(x=>x.id===id);if(item)fillForm(item)};\n    window.deleteRequest=async function(id){if(!confirm(\'Удалить заявку?\'))return;await api(\'/api/requests/\'+id,{method:\'DELETE\'});await loadItems()};\n    function openNewRequestForm(){resetForm();openDrawer()}\n    els.loginBtn.addEventListener(\'click\',()=>login().catch(()=>alert(\'Неверный логин или пароль\')));els.logoutBtn.addEventListener(\'click\',()=>logout());els.themeBtn.addEventListener(\'click\',()=>setTheme(state.theme===\'dark\'?\'light\':\'dark\'));els.prevMonthBtn.addEventListener(\'click\',()=>{state.currentMonth=new Date(state.currentMonth.getFullYear(),state.currentMonth.getMonth()-1,1);renderCalendar()});els.nextMonthBtn.addEventListener(\'click\',()=>{state.currentMonth=new Date(state.currentMonth.getFullYear(),state.currentMonth.getMonth()+1,1);renderCalendar()});els.directDateFilter.addEventListener(\'change\',()=>{state.selectedDate=els.directDateFilter.value;state.currentMonth=new Date(state.selectedDate+\'T00:00:00\');renderCalendar();renderRequests()});[els.searchInput,els.statusFilter,els.assigneeFilter].forEach(el=>{el.addEventListener(\'input\',renderRequests);el.addEventListener(\'change\',renderRequests)});[els.openFormFabBtn,els.openFormDesktopBtn,els.openFormAsideBtn].forEach(btn=>{if(btn)btn.addEventListener(\'click\',openNewRequestForm)});els.closeDrawerBtn.addEventListener(\'click\',closeDrawer);els.drawer.addEventListener(\'click\',e=>{if(e.target===els.drawer)closeDrawer()});els.resetFormBtn.addEventListener(\'click\',resetForm);els.requestForm.addEventListener(\'submit\',saveRequest);setTheme(state.theme);els.directDateFilter.value=state.selectedDate;\n  </script>\n</body>\n</html>'

class RequestIn(BaseModel):
    client: str = Field(min_length=1)
    visit_date: str = Field(min_length=16)
    address: str = Field(min_length=1)
    phone: str = Field(min_length=1)
    status: str
    price: float = 0
    comment: Optional[str] = ''
    assignee: str

def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=5)
    conn.row_factory = sqlite3.Row
    conn.execute('PRAGMA journal_mode=WAL;')
    conn.execute('PRAGMA synchronous=NORMAL;')
    conn.execute('PRAGMA busy_timeout=5000;')
    return conn

def init_db():
    conn = get_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            client TEXT NOT NULL,
            visit_date TEXT NOT NULL,
            address TEXT NOT NULL,
            phone TEXT NOT NULL,
            status TEXT NOT NULL,
            price REAL NOT NULL DEFAULT 0,
            comment TEXT,
            assignee TEXT NOT NULL,
            created_by TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
    """)
    count = conn.execute('SELECT COUNT(*) AS c FROM requests').fetchone()['c']
    if count == 0:
        now = datetime.now().replace(second=0, microsecond=0)
        samples = [
            ('Сергей', now.isoformat(timespec='minutes'), 'Мытищи, ул. Лётная, 21', '+7 999 111-22-33', 'new', 0, 'Починить розетку на кухне', 'master1', 'master1', now.isoformat(timespec='minutes')),
            ('Анна', now.replace(hour=14, minute=30).isoformat(timespec='minutes'), 'Королёв, пр-т Космонавтов, 14', '+7 999 444-55-66', 'scheduled', 3500, 'Сборка шкафа, есть фото в переписке', 'master2', 'master2', now.isoformat(timespec='minutes')),
            ('Олег', now.replace(day=now.day if now.day < 28 else 28, hour=18, minute=0).isoformat(timespec='minutes'), 'Пушкино, ул. Чехова, 7', '+7 999 777-88-99', 'done', 6200, 'Замена смесителя и герметизация', 'master1', 'master1', now.isoformat(timespec='minutes')),
        ]
        conn.executemany('INSERT INTO requests (client, visit_date, address, phone, status, price, comment, assignee, created_by, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)', samples)
    conn.commit()
    conn.close()

def get_current_user(credentials: HTTPBasicCredentials = Depends(security)):
    user = USERS.get(credentials.username)
    if not user or not secrets.compare_digest(credentials.password, user['password']):
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail='Unauthorized', headers={'WWW-Authenticate': 'Basic'})
    return {'id': credentials.username, 'name': user['name']}

@app.on_event('startup')
def on_startup():
    init_db()

@app.get('/', response_class=HTMLResponse)
def index():
    return HTMLResponse(INDEX_HTML)

@app.get('/health')
def health():
    return JSONResponse({'ok': True})

@app.get('/api/me')
def me(user=Depends(get_current_user)):
    return user

@app.get('/api/requests')
def list_requests(user=Depends(get_current_user), date_from: Optional[str] = Query(default=None), date_to: Optional[str] = Query(default=None)):
    conn = get_db()
    sql = 'SELECT * FROM requests WHERE 1=1'
    params = []
    if date_from:
        sql += ' AND visit_date >= ?'
        params.append(date_from)
    if date_to:
        sql += ' AND visit_date <= ?'
        params.append(date_to)
    sql += ' ORDER BY visit_date ASC, id DESC'
    rows = conn.execute(sql, params).fetchall()
    conn.close()
    result = []
    for row in rows:
        item = dict(row)
        item['assignee_name'] = USERS.get(item['assignee'], {}).get('name', item['assignee'])
        result.append(item)
    return result

@app.post('/api/requests')
def create_request(payload: RequestIn, user=Depends(get_current_user)):
    if payload.status not in STATUSES:
        raise HTTPException(400, 'Bad status')
    if payload.assignee not in USERS:
        raise HTTPException(400, 'Bad assignee')
    now = datetime.now().replace(second=0, microsecond=0).isoformat(timespec='minutes')
    conn = get_db()
    cur = conn.execute('INSERT INTO requests (client, visit_date, address, phone, status, price, comment, assignee, created_by, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)', (payload.client, payload.visit_date, payload.address, payload.phone, payload.status, payload.price, payload.comment, payload.assignee, user['id'], now))
    conn.commit()
    new_id = cur.lastrowid
    conn.close()
    return {'ok': True, 'id': new_id}

@app.put('/api/requests/{request_id}')
def update_request(request_id: int, payload: RequestIn, user=Depends(get_current_user)):
    if payload.status not in STATUSES:
        raise HTTPException(400, 'Bad status')
    if payload.assignee not in USERS:
        raise HTTPException(400, 'Bad assignee')
    now = datetime.now().replace(second=0, microsecond=0).isoformat(timespec='minutes')
    conn = get_db()
    cur = conn.execute('UPDATE requests SET client=?, visit_date=?, address=?, phone=?, status=?, price=?, comment=?, assignee=?, updated_at=? WHERE id=?', (payload.client, payload.visit_date, payload.address, payload.phone, payload.status, payload.price, payload.comment, payload.assignee, now, request_id))
    conn.commit()
    changed = cur.rowcount
    conn.close()
    if not changed:
        raise HTTPException(404, 'Not found')
    return {'ok': True}

@app.delete('/api/requests/{request_id}')
def delete_request(request_id: int, user=Depends(get_current_user)):
    conn = get_db()
    cur = conn.execute('DELETE FROM requests WHERE id=?', (request_id,))
    conn.commit()
    changed = cur.rowcount
    conn.close()
    if not changed:
        raise HTTPException(404, 'Not found')
    return {'ok': True}
